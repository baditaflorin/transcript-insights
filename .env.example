# ============================================================
# Transcript Insights — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
#
# API keys are entered by the user in the UI and stored in
# localStorage. The server-side environment variables below
# are only needed if you want to pre-configure a default key.
# ============================================================

# Optional: Google AI (Gemini) API key
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Optional: OpenAI API key
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
